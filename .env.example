# Copy to .env.local and fill in. Never commit .env.local.

# Google OAuth client (type: Web application) from Google Cloud Console.
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key from the Claude Console (platform.claude.com > API keys).
ANTHROPIC_API_KEY=
# Only for keys that aren't scoped to a workspace: the workspace to bill (wrkspc_…).
ANTHROPIC_WORKSPACE_ID=

# Encrypts the Gmail session cookie. Any long random string; changing it signs you out.
SESSION_SECRET=

APP_URL=http://localhost:3000
OWNER_NAME=Damien

# Supabase > Connect > Transaction pooler (port 6543), with the database password filled in.
DATABASE_URL=

# Only this Google account can sign in to Atlas (required once it is on the internet).
OWNER_EMAIL=
# Random secret shared with the Supabase cron jobs that call /api/cron/*.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Atlas keeps this time zone wherever it runs.
APP_TIMEZONE=Australia/Perth
